[Unit]
Description=Publicador de arquivos estáticos
Wants=network-online.target
After=network-online.target

[Service]
User=publicador-estatico
WorkingDirectory=/opt/publicador-estatico
EnvironmentFile=/etc/publicador-estatico.env
Environment=PYTHONDONTWRITEBYTECODE=1
StateDirectory=publicador-estatico
StateDirectoryMode=0755
UMask=0022
ExecStart=/usr/bin/python3 /opt/publicador-estatico/publicador.py
Restart=on-failure
RestartSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target

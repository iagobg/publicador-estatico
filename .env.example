# Origem autorizada. Use uma pasta que contenha um index.html pronto para servir.
GITHUB_REPO=conta/repositorio
GITHUB_BRANCH=main
SOURCE_DIR=exemplo/site
# Opcional em repositórios públicos. Em repositórios privados, Contents: read.
GITHUB_TOKEN=
# Caminho exclusivo do publicador, fora da árvore de código.
DEPLOY_DIR=./estado
# Servidor HTTP cuja raiz é DEPLOY_DIR/current.
SITE_URL=http://127.0.0.1:8080
POLL_SECONDS=120
